{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cait-schema.local/schemas/cait/common.schema.json",
  "title": "CAIT Common Definitions",
  "description": "Reusable definitions for CAIT-style records.",
  "type": "object",
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "default": []
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["candidate", "accepted", "conditional", "quarantined", "expired", "revoked"]
    },
    "evidence_mode": {
      "type": "string",
      "enum": [
        "deterministic_proof",
        "replay_certificate",
        "anytime_statistical_process",
        "partial_identification_interval",
        "expert_assurance_claim",
        "registered_hybrid"
      ]
    },
    "defeater_severity": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "blocking"]
    },
    "decision_status": {
      "type": "string",
      "enum": ["pass", "conditional", "fail"]
    },
    "target_coordinate_status": {
      "type": "string",
      "enum": ["accepted", "conditional", "abstained_or_uncertified", "failed"]
    },
    "status_effect": {
      "type": "string",
      "enum": ["full", "discounted_and_scoped", "zero_for_affected_scope", "bottom_for_affected_scope"]
    },
    "subcertificate_status": {
      "type": "string",
      "enum": ["accepted", "conditional", "failed"]
    },
    "resolution_status": {
      "type": "string",
      "enum": ["unresolved", "resolved", "expired", "quarantined"]
    },
    "interval": {
      "type": "object",
      "description": "Numeric lower/upper interval. Python validation checks lower <= upper.",
      "required": ["lower", "upper", "unit"],
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/non_empty_string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "resource_usage": {
      "type": "object",
      "required": ["dollars", "gpu_hours", "verifier_hours", "risk_budget"],
      "properties": {
        "dollars": {
          "type": "number",
          "minimum": 0
        },
        "gpu_hours": {
          "type": "number",
          "minimum": 0
        },
        "verifier_hours": {
          "type": "number",
          "minimum": 0
        },
        "risk_budget": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "domain_witness_flags": {
      "type": "object",
      "required": [
        "compatible_scope",
        "accepted_dependencies",
        "valid_budget",
        "fresh_evidence",
        "no_open_blocking_defeater",
        "disjoint_support"
      ],
      "properties": {
        "compatible_scope": {
          "type": "boolean"
        },
        "accepted_dependencies": {
          "type": "boolean"
        },
        "valid_budget": {
          "type": "boolean"
        },
        "fresh_evidence": {
          "type": "boolean"
        },
        "no_open_blocking_defeater": {
          "type": "boolean"
        },
        "disjoint_support": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "target_coordinate_result": {
      "type": "object",
      "required": ["coordinate", "status", "within_boundary"],
      "properties": {
        "coordinate": {
          "$ref": "#/$defs/non_empty_string"
        },
        "status": {
          "$ref": "#/$defs/target_coordinate_status"
        },
        "within_boundary": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "target_defeater": {
      "type": "object",
      "required": ["defeater_id", "severity", "resolution_status", "affected_target_coordinates"],
      "properties": {
        "defeater_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "severity": {
          "$ref": "#/$defs/defeater_severity"
        },
        "resolution_status": {
          "$ref": "#/$defs/resolution_status"
        },
        "affected_target_coordinates": {
          "$ref": "#/$defs/string_array"
        }
      },
      "additionalProperties": false
    },
    "operational_metrics": {
      "type": "object",
      "required": [
        "external_injection_share",
        "unresolved_attribution_share",
        "transfer_coverage",
        "audit_freshness",
        "residual_risk"
      ],
      "properties": {
        "external_injection_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unresolved_attribution_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transfer_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "audit_freshness": {
          "$ref": "#/$defs/decision_status"
        },
        "residual_risk": {
          "$ref": "#/$defs/interval"
        }
      },
      "additionalProperties": false
    },
    "acceptance_thresholds": {
      "type": "object",
      "description": "Registry-specific, non-universal thresholds used by lightweight local arrival validation. These are not universal CAIT thresholds.",
      "required": [
        "max_external_injection_share",
        "max_unresolved_attribution_share",
        "min_transfer_coverage",
        "max_residual_risk_upper"
      ],
      "properties": {
        "max_external_injection_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_unresolved_attribution_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_transfer_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_residual_risk_upper": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
