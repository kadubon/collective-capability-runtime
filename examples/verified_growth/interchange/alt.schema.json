{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alt-foundry-kernel:schema:token:0.4.0",
  "title": "ALT Abstraction Token",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "token_id",
    "version",
    "signature",
    "representation",
    "adapter",
    "verifier_contract",
    "guard",
    "cost_risk_model",
    "provenance",
    "dependencies"
  ],
  "properties": {
    "token_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "object"
    },
    "representation": {
      "type": "object"
    },
    "adapter": {
      "type": "object"
    },
    "verifier_contract": {
      "type": "object"
    },
    "guard": {
      "type": "object"
    },
    "cost_risk_model": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
